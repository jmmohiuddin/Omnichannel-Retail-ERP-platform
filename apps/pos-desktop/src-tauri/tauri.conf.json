{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OmniRetail POS",
  "version": "0.1.0",
  "identifier": "ae.omniretail.pos",
  "build": {
    "frontendDist": "../../pos/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npx -y pnpm --filter @omniretail/pos dev",
    "beforeBuildCommand": "npx -y pnpm --filter @omniretail/pos build"
  },
  "app": {
    "windows": [
      {
        "title": "OmniRetail POS",
        "width": 1366,
        "height": 850,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
