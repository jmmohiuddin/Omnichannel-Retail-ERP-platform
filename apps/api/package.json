{
  "name": "@omniretail/api",
  "version": "0.1.0",
  "type": "module",
  "comment:exports": "The payment effect path is shared with @omniretail/worker's reconciler (R6.2), and the notification transport with its delivery job (R13). Exposed as explicit subpaths so the worker imports exactly those, not the Fastify app.",
  "exports": {
    "./db": "./dist/db.js",
    "./payments": "./dist/payments/paymentService.js",
    "./payments/gateway": "./dist/payments/gatewayPort.js",
    "./notify/transport": "./dist/notify/smtpTransport.js",
    "./notify/templates": "./dist/notify/templates.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "node --watch dist/main.js",
    "start": "node dist/main.js",
    "seed": "node dist/seed.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@omniretail/db": "workspace:*",
    "@omniretail/domain": "workspace:*",
    "fastify": "^5.0.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
