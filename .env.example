# --- API ---
# Runtime connection: non-superuser role subject to row-level security.
DATABASE_URL=postgres://omniretail_app:omniretail_app_dev@localhost:5432/omniretail_dev
# Schema-owner connection: used only to apply migrations at boot (optional).
ADMIN_DATABASE_URL=postgres://omniretail:omniretail_dev@localhost:5432/omniretail_dev
# Minimum 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-please
PORT=3001

# --- Worker (outbox relay) ---
WORKER_DATABASE_URL=postgres://omniretail_worker:omniretail_worker_dev@localhost:5432/omniretail_dev
REDIS_URL=redis://localhost:6379
