# --- API ---
# Runtime connection: non-superuser role subject to row-level security.
DATABASE_URL=postgres://omniretail_app:omniretail_app_dev@localhost:5432/omniretail_dev
# Schema-owner connection: used only to apply migrations at boot (optional).
ADMIN_DATABASE_URL=postgres://omniretail:omniretail_dev@localhost:5432/omniretail_dev
# Minimum 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-please
PORT=3001

# Optional: enables real Claude narration on /v1/ai/daily-digest
# (falls back to a deterministic stub when unset).
# ANTHROPIC_API_KEY=sk-ant-...

# --- Error tracking (R12.10, R14.6) ---
# Unset = reporting off. An unparseable value also degrades to off rather than
# stopping the process from booting. Only unhandled 500s are reported; typed
# 4xx failures are expected and stay out of the alert stream.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=<git sha>

# --- Notification delivery (R13.1) ---
# Unset = the outbox still records every notification, but nothing is sent and
# rows stay `pending`. Set these and the worker's notification job delivers.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# SMTP_FROM="Voltix <orders@example.ae>"

# --- Backups (R14.1) ---
# Destination for scheduled logical dumps. See docs/runbooks/backup-restore.md.
# BACKUP_S3_BUCKET=voltix-backups
# BACKUP_S3_PREFIX=omniretail_prod
# BACKUP_RETENTION_DAYS=35

# --- Worker (outbox relay) ---
WORKER_DATABASE_URL=postgres://omniretail_worker:omniretail_worker_dev@localhost:5432/omniretail_dev
REDIS_URL=redis://localhost:6379
